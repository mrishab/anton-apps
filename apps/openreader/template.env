# Global
HOST_TZ=<PUT-HOST-TZ-HERE>
APP_PUID=<PUT-APP-PUID-HERE>
APP_PGID=<PUT-APP-PGID-HERE>

# OpenReader (Document reader with synchronized TTS audio playback)
OPENREADER_WEB_PORT=<PUT-OPENREADER-WEB-PORT-HERE>
OPENREADER_PLAYBACK_PORT=<PUT-OPENREADER-PLAYBACK-PORT-HERE>
OPENREADER_CONFIG_MOUNT_DIR=<PUT-OPENREADER-CONFIG-MOUNT-DIR-HERE>
OPENREADER_DATA_MOUNT_DIR=<PUT-OPENREADER-DATA-MOUNT-DIR-HERE>

# OpenReader Authentication & Networking
OPENREADER_BASE_URL=<PUT-OPENREADER-BASE-URL-HERE>
OPENREADER_AUTH_SECRET=<PUT-OPENREADER-AUTH-SECRET-32-CHAR-RANDOM-HERE>
OPENREADER_BOOTSTRAP_ADMIN_EMAIL=<PUT-OPENREADER-BOOTSTRAP-ADMIN-EMAIL-HERE>
OPENREADER_BOOTSTRAP_ADMIN_PASSWORD=<PUT-OPENREADER-BOOTSTRAP-ADMIN-PASSWORD-16-PLUS-CHARS-HERE>
OPENREADER_USE_ANONYMOUS_AUTH_SESSIONS=false

# Embedded Compute Worker Configuration
OPENREADER_COMPUTE_WORKER_HOST=0.0.0.0
OPENREADER_COMPUTE_WORKER_PUBLIC_URL=<PUT-OPENREADER-COMPUTE-WORKER-PUBLIC-URL-HERE>
OPENREADER_TTS_PLAYBACK_TOKEN_SECRET=<PUT-OPENREADER-TTS-PLAYBACK-TOKEN-SECRET-HERE>

# Kokoro TTS Provider Integration (Connected to kokoro-tts app)
OPENREADER_TTS_API_BASE=http://172.17.0.1:8880/v1
OPENREADER_TTS_API_MODEL_NAME=kokoro
# Example: {"version":1,"runtimeConfig":{"defaultTtsProvider":"kokoro"},"providers":[{"slug":"kokoro","displayName":"Kokoro (Local GPU)","providerType":"custom-openai","baseUrl":"http://172.17.0.1:8880/v1","defaultModel":"kokoro","enabled":true}]}
OPENREADER_RUNTIME_SEED_JSON=<PUT-OPENREADER-RUNTIME-SEED-JSON-HERE>
OPENREADER_WEED_MINI_WAIT_SEC=90
