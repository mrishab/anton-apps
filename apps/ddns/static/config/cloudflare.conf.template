######################################################################
## Cloudflare Dynamic DNS Configuration for ddclient
##
## Refreshes and updates public IP address on Cloudflare proxied DNS records
######################################################################
daemon=300                              # Check every 300 seconds
syslog=yes                              # Log update messages to syslog
pid=/var/run/ddclient/ddclient.pid      # Record PID in file
ssl=yes                                 # Use SSL

# Detect public IP address via Cloudflare checkip service
use=web, web=cloudflare.com/cdn-cgi/trace

# ─────────────────────────────────────────────────────────────────────
# <your-domain> (Cloudflare DNS)
# ─────────────────────────────────────────────────────────────────────
# Duplicate this block for each domain you want to update.
# Replace <your-domain> with your actual domain for the zone= line.
protocol=cloudflare
zone=<your-domain>
ttl=1
login=token
password=<redacted>
domain.com,*.domain.com,ovpn.domain.com

# ─────────────────────────────────────────────────────────────────────
# <your-personal-domain> (Cloudflare DNS) — when apex/www/apps are on GitHub Pages
# ─────────────────────────────────────────────────────────────────────
# If the root domain, www, and apps subdomains point to GitHub Pages, only update self-hosted
# subdomains (e.g. blog) and wildcard records with ddclient.
# Do NOT list the apex domain or GitHub Pages subdomains (e.g. www, apps) here so ddclient does not overwrite GitHub Pages.
# protocol=cloudflare
# zone=<your-personal-domain>
# ttl=1
# login=token
# password=<redacted>
# blog.<your-personal-domain>,*.<your-personal-domain>
