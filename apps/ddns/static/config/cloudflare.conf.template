######################################################################
## Cloudflare Dynamic DNS Configuration for ddclient
##
## Refreshes and updates public IP address on Cloudflare proxied DNS records
######################################################################
daemon=300                              # Check every 300 seconds
syslog=yes                              # Log update messages to syslog
pid=/var/run/ddclient/ddclient.pid      # Record PID in file
ssl=yes                                 # Use SSL

# Detect public IP address via Cloudflare checkip service
use=web, web=checkip.cloudflare.com/

# ─────────────────────────────────────────────────────────────────────
# <your-domain> (Cloudflare DNS)
# ─────────────────────────────────────────────────────────────────────
protocol=cloudflare
zone=<your-domain>
ttl=1
login=token
password=<redacted>
*, @

# ─────────────────────────────────────────────────────────────────────
# <your-personal-domain> (Cloudflare DNS)
# ─────────────────────────────────────────────────────────────────────
protocol=cloudflare
zone=<your-personal-domain>
ttl=1
login=token
password=<redacted>
*, @
