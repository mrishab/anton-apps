# Global
HOST_TZ=<PUT-HOST-TZ-HERE>
APP_PUID=<PUT-APP-PUID-HERE>
APP_PGID=<PUT-APP-PGID-HERE>

# Kokoro-TTS (Self-hosted TTS powered by Kokoro-82M on NVIDIA GPU)
KOKORO_TTS_PORT=<PUT-KOKORO-TTS-PORT-HERE>
KOKORO_TTS_API_KEY=<PUT-KOKORO-TTS-API-KEY-HERE>
KOKORO_TTS_CONFIG_MOUNT_DIR=<PUT-KOKORO-TTS-CONFIG-MOUNT-DIR-HERE>
KOKORO_TTS_DATA_MOUNT_DIR=<PUT-KOKORO-TTS-DATA-MOUNT-DIR-HERE>
KOKORO_TTS_USE_GPU=true
KOKORO_TTS_DEVICE_TYPE=cuda
KOKORO_TTS_DEFAULT_VOICE=af_heart
KOKORO_TTS_API_LOG_LEVEL=INFO
KOKORO_TTS_ENABLE_WEB_PLAYER=true
KOKORO_TTS_CORS_ENABLED=true
