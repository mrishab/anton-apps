# Global
HOST_TZ=<PUT-HOST-TZ-HERE>
APP_PUID=<PUT-APP-PUID-HERE>
APP_PGID=<PUT-APP-PGID-HERE>

# FlareSolverr
FLARESOLVERR_PORT=<PUT-FLARESOLVERR-PORT-HERE> # Default: 8191
FLARESOLVERR_LOG_LEVEL=<PUT-FLARESOLVERR-LOG-LEVEL-HERE> # Options: info, debug, verbose, warn, error (default: info)
FLARESOLVERR_LOG_HTML=<PUT-FLARESOLVERR-LOG-HTML-HERE> # Options: true, false (default: false)
FLARESOLVERR_CAPTCHA_SOLVER=<PUT-FLARESOLVERR-CAPTCHA-SOLVER-HERE> # Options: none, hcaptcha (default: none)
